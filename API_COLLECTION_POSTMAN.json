{
  "info": {
    "name": "Sistema Financiero - API Completa",
    "description": "Colección completa de endpoints REST para el Sistema Financiero",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/AplicacionesJFCC/sistema-financiera",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data.token) {",
                  "        pm.collectionVariables.set('auth_token', jsonData.data.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"usuario\": \"admin\",\n    \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/app/api/auth/login.php",
              "host": ["{{base_url}}"],
              "path": ["app", "api", "auth", "login.php"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
            "url": {
              "raw": "{{base_url}}/app/api/auth/logout.php",
              "host": ["{{base_url}}"],
              "path": ["app", "api", "auth", "logout.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar Clientes",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
            "url": {
              "raw": "{{base_url}}/app/api/clientes/list.php?page=1&limit=20&search=",
              "host": ["{{base_url}}"],
              "path": ["app", "api", "clientes", "list.php"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "20"},
                {"key": "search", "value": ""}
              ]
            }
          }
        },
        {
          "name": "Obtener Cliente",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
            "url": {
              "raw": "{{base_url}}/app/api/clientes/get.php?id=1",
              "host": ["{{base_url}}"],
              "path": ["app", "api", "clientes", "get.php"],
              "query": [{"key": "id", "value": "1"}]
            }
          }
        },
        {
          "name": "Crear Cliente",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{auth_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre_completo\": \"Juan Pérez\",\n    \"tipo_documento\": \"DNI\",\n    \"numero_documento\": \"12345678\",\n    \"telefono\": \"987654321\",\n    \"email\": \"juan@example.com\",\n    \"direccion\": \"Calle 123\",\n    \"fecha_nacimiento\": \"1990-01-01\",\n    \"ocupacion\": \"Comerciante\",\n    \"cobrador_id\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/app/api/clientes/create.php",
              "host": ["{{base_url}}"],
              "path": ["app", "api", "clientes", "create.php"]
            }
          }
        },
        {
          "name": "Actualizar Cliente",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{auth_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id\": 1,\n    \"nombre_completo\": \"Juan Pérez Actualizado\",\n    \"telefono\": \"987654322\",\n    \"estado\": \"activo\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/app/api/clientes/update.php",
              "host": ["{{base_url}}"],
              "path": ["app", "api", "clientes", "update.php"]
            }
          }
        },
        {
          "name": "Eliminar Cliente",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
            "url": {
              "raw": "{{base_url}}/app/api/clientes/delete.php?id=1",
              "host": ["{{base_url}}"],
              "path": ["app", "api", "clientes", "delete.php"],
              "query": [{"key": "id", "value": "1"}]
            }
          }
        }
      ]
    },
